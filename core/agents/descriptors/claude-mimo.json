{
  "name": "claude-mimo",
  "displayName": "Claude MiMo",
  "command": "claude-agent-acp",
  "sessionMcpServers": false,
  "fallbackCommand": "npx",
  "fallbackArgs": ["-y", "@agentclientprotocol/claude-agent-acp"],
  "args": [],
  "capabilities": ["plan", "execute", "verify", "review", "remediate"],
  "defaultRoles": ["verifier", "reviewer", "remediator"],
  "stability": "stable",
  "envPrefix": "CPB_ACP_CLAUDE_MIMO",
  "protocol": "acp",
  "description": "Claude Code ACP runner configured through the MiMo Anthropic-compatible variant",
  "providerKey": "claude:mimo-v2.5pro",
  "providerVariant": "mimo-v2.5pro",
  "transport": "claude-cli",
  "lifecycle": "one-shot",
  "providerFamily": "mimo",
  "tieBreakPriority": 40,
  "sandboxPolicy": "cpb-required",
  "inheritFiles": [
    { "from": "$HOME/.claude.json", "to": "$HOME/.claude.json" },
    { "from": "$HOME/.claude/.credentials.json", "to": "$HOME/.claude/.credentials.json" },
    { "from": "$HOME/.claude/credentials.json", "to": "$HOME/.claude/credentials.json" },
    { "from": "$HOME/.claude/auth.json", "to": "$HOME/.claude/auth.json" }
  ],
  "quarantineFiles": [],
  "resumeCommand": "claude",
  "resumeArgs": ["--resume"]
}
