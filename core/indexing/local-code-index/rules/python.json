{
  "version": "1.0.0",
  "language": "python",
  "aliases": ["py", "python3", "py3"],
  "extensions": [".py", ".pyi", ".pyw"],
  "symbolKinds": {
    "function": "Function definition (def)",
    "class": "Class definition",
    "variable": "Module-level variable or assignment",
    "method": "Class method (function defined inside a class)",
    "property": "Decorated property getter",
    "parameter": "Function parameter (when annotated or defaulted at top level)",
    "decorator": "Decorator usage",
    "import-name": "Imported name (from import or aliased import)"
  },
  "patterns": {
    "definitions": [
      {
        "kind": "function",
        "pattern": "^\\s*(?<decorator>@[a-zA-Z_][a-zA-Z0-9_.]*(?:\\([^)]*\\))?\\s+)*(?:\\s*async\\s+)?def\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:\\[[^\\]]*\\])?\\s*\\(",
        "description": "Function definition with optional async and decorators"
      },
      {
        "kind": "class",
        "pattern": "^\\s*(?<decorator>@[a-zA-Z_][a-zA-Z0-9_.]*(?:\\([^)]*\\))?\\s+)*class\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*\\[[^\\]]*\\])?(?:\\s*\\([^)]*\\))?\\s*:",
        "description": "Class definition with optional decorators and bases"
      },
      {
        "kind": "variable",
        "pattern": "^(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?::\\s*[^=]+)?\\s*=",
        "description": "Module-level assignment (variable)"
      },
      {
        "kind": "variable",
        "pattern": "^\\s*(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?::\\s*[^=]+)?\\s*=\\s*(?!\\=)",
        "description": "Instance or class variable assignment"
      },
      {
        "kind": "method",
        "pattern": "^\\s{2,}(?<decorator>@[a-zA-Z_][a-zA-Z0-9_.]*(?:\\([^)]*\\))?\\s+)*(?:\\s*async\\s+)?def\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:\\[[^\\]]*\\])?\\s*\\(",
        "description": "Method definition (indented inside class)"
      },
      {
        "kind": "property",
        "pattern": "^\\s{2,}@property\\s+\\n\\s+def\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
        "description": "Property getter (decorated with @property)"
      },
      {
        "kind": "decorator",
        "pattern": "^\\s*@(?<name>[a-zA-Z_][a-zA-Z0-9_.]*(?:\\([^)]*\\))?)",
        "description": "Decorator usage"
      }
    ],
    "imports": [
      {
        "pattern": "^from\\s+(?<source>[a-zA-Z_][a-zA-Z0-9_.]*)\\s+import\\s+(?<names>\\([^)]+\\)|[^\n]+)",
        "kind": "all",
        "description": "From-import (from X import Y, Z)"
      },
      {
        "pattern": "^import\\s+(?<source>[a-zA-Z_][a-zA-Z0-9_.]*)(?:\\s+as\\s+(?<alias>[a-zA-Z_][a-zA-Z0-9_]*))?",
        "kind": "all",
        "description": "Import statement (import X, import X as Y)"
      },
      {
        "pattern": "^import\\s+(?<names>[a-zA-Z_][a-zA-Z0-9_.]*(?:\\s*,\\s*[a-zA-Z_][a-zA-Z0-9_.]*)*)",
        "kind": "all",
        "description": "Multiple imports (import X, Y, Z)"
      }
    ],
    "exports": [
      {
        "pattern": "^__(?<name>all__)\\s*=\\s*\\[",
        "kind": "named",
        "description": "__all__ declaration (explicit public API)"
      },
      {
        "pattern": "^def\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)",
        "kind": "named",
        "description": "Module-level function (implicitly exported)"
      },
      {
        "pattern": "^class\\s+(?<name>[a-zA-Z_][a-zA-Z0-9_]*)",
        "kind": "named",
        "description": "Module-level class (implicitly exported)"
      },
      {
        "pattern": "^(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
        "kind": "named",
        "description": "Module-level variable (implicitly exported)"
      }
    ],
    "references": [
      {
        "pattern": "\\b(?<name>[a-zA-Z_][a-zA-Z0-9_]*)\\b",
        "excludeContexts": ["comment", "string", "definition"],
        "description": "General identifier reference"
      }
    ]
  },
  "folding": {
    "startPattern": ":\\s*$",
    "endPattern": "^(?!(\\s{4,}|\\t+))\\S"
  },
  "notes": "Python rules use indentation-aware patterns. The variable pattern at module level only matches zero-indent assignments. Methods are detected by indentation level (2+ spaces). Decorators are tracked separately. Python 3.12+ type parameter syntax (def func[T]()) is supported via the generics capture group."
}
